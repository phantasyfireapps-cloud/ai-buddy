# Copy to .env.local (development) or .env.production.local (release builds) and fill in.
# Local development with `supabase start` prints these values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Public anon/publishable key only. NEVER put the service_role/secret key in the app.
VITE_SUPABASE_ANON_KEY=
# Optional: FastAPI service (Phase 2+). Leave blank if not running.
VITE_API_URL=
